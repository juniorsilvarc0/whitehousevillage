# ───────── Aplicação ─────────
APP_ENV=development
APP_NAME=whitehousevillage
TZ=America/Fortaleza

# ───────── Banco ─────────
POSTGRES_USER=whv
POSTGRES_PASSWORD=changeme
POSTGRES_DB=whitehousevillage
# Porta publicada no host (dentro do compose é sempre 5432)
POSTGRES_PORT=5433
DATABASE_URL=postgres://whv:changeme@postgres:5432/whitehousevillage?sslmode=disable

# ───────── API ─────────
# Porta que o processo da API escuta. Dentro do compose ela é FIXA em 8080
# (o painel e o healthcheck contam com isso); esta linha vale para rodar a API
# fora do Docker (`go run ./cmd/api`).
API_PORT=8080
# Porta publicada no HOST pelo compose. É esta que se troca quando a 8080 da
# máquina já está ocupada — e quem usa a 8080 do host (API_BASE_URL,
# ICAL_EXPORT_BASE_URL, `make smoke-stack`) acompanha a troca.
API_HOST_PORT=8080
API_BASE_URL=http://localhost:8080
JWT_SECRET=troque-por-32-bytes-aleatorios
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Volume das fotos e vídeos do site (menu Site do painel). No compose é /data/midia.
# MEDIA_DIR=./data/midia

# ───────── Admin (Next.js) ─────────
NEXT_PUBLIC_APP_NAME=White House Village
API_INTERNAL_URL=http://api:8080
SESSION_COOKIE_NAME=whv-session
# Porta publicada no host para o painel (dentro do compose é sempre 3000)
ADMIN_PORT=3100

# ───────── Site público (nginx, estático) ─────────
# Porta publicada no host (dentro do compose é sempre 80)
SITE_PORT=3200

# ───────── WhatsApp (uazapi) ─────────
UAZAPI_BASE_URL=
UAZAPI_TOKEN=
UAZAPI_WEBHOOK_SECRET=

# ───────── Agente de IA ─────────
AI_RELAY_URL=

# ───────── Canais / OTA ─────────
ICAL_EXPORT_BASE_URL=http://localhost:8080/ical
ICAL_PULL_INTERVAL=15m

# ───────── Produção (Traefik) ─────────
DOMAIN=
ACME_EMAIL=
