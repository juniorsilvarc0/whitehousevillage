# Modelo do infra/.env.production da VPS. Copie, preencha e NUNCA commite o real
# (o .gitignore cobre infra/.env.production).
#   cp infra/.env.production.example infra/.env.production && chmod 600 infra/.env.production
# Gere segredos com: openssl rand -base64 48

# ── Banco ──
POSTGRES_USER=whv
POSTGRES_PASSWORD=TROQUE-gere-com-openssl
POSTGRES_DB=whitehousevillage
# Mesma senha de cima. Host `postgres` é o nome do serviço na rede interna.
DATABASE_URL=postgres://whv:TROQUE-gere-com-openssl@postgres:5432/whitehousevillage?sslmode=disable

# ── API ──
# Em produção a API recusa subir com menos de 32 bytes.
JWT_SECRET=TROQUE-gere-com-openssl-48-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
LOG_LEVEL=info
# O navegador nunca chama a API (o painel é BFF); a lista fica restrita aos
# endereços oficiais para o dia em que o site passar a chamar (passo A2).
CORS_ORIGINS=https://www.whitehousevillage.com.br,https://gestor.whitehousevillage.com.br,https://corretor.whitehousevillage.com.br

# ── Certificado (Let's Encrypt) ──
ACME_EMAIL=seu-email@dominio.com.br

# ── Contas de demonstração ──
# `true` cria admin@wh.local, gestao@wh.local e corretor@wh.local com a senha
# conhecida do repositório. Só para a apresentação: troque as senhas logo depois
# (tela de usuários) e volte para false.
SEED_DEV_USERS=false

# ── Portas locais (só 127.0.0.1) para o proxy que já roda na VPS ──
# Escolha portas que NADA na VPS usa; o deploy.sh confere antes de subir.
WHV_ADMIN_PORT=3110
WHV_SITE_PORT=3210
